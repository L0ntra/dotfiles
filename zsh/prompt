#             Git Auto-complete
##############################################
# Load Git completion
zstyle ':completion:*:*:git:*' script ~/.zsh/git-completion.bash
fpath=(~/.zsh $fpath)

autoload -Uz compinit && compinit

#                  Prompt
##############################################
# Color Picker:  https://robotmoon.com/zsh-prompt-generator/

# Load version control information
autoload -Uz vcs_info
precmd() { vcs_info }

# Format the vcs_info_msg_0_ variable
zstyle ':vcs_info:git:*' formats '%b'

# Set up the prompt (with git branch name)

function get_branch() { echo -e "%F{184}${vcs_info_msg_0_}%f" }

function get_pwd(){
  git_root=$PWD
  while [[ $git_root != / && ! -e $git_root/.git ]]; do
    git_root=$git_root:h
  done
  if [[ $git_root = / ]]; then
    unset git_root
    prompt_short_dir='%F{34}%~%f'
  else
    parent=${git_root%\/*}
    prompt_short_dir="%F{40}%Bλ%b%f %F{34}${PWD#$parent/}%f"
  fi
  echo -e "$prompt_short_dir"
}

setopt PROMPT_SUBST
TIME=$'%F{128}[%*]%f'
PERC=$'%F{249}%%%f'
USER=$'%F{60}\{%n\}%f'
NEWLINE=$'\n'
PROMPT='$USER $(get_pwd) $(get_branch)$NEWLINE$TIME $PERC '
